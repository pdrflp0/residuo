# Somente desenvolvimento local. Não use credenciais reais.
TARGET_DATABASE_URL=postgres://residuo:residuo-local-only@localhost:54329/residuo_target
LAB_DATABASE_URL=postgres://residuo:residuo-local-only@localhost:54329/residuo_lab
REFERENCE_SERVICE_URL=http://localhost:4100

# Opcional: resumo com IA (nível 3). Sem a chave, o recurso fica desligado.
# Ao gerar um resumo, o relatório sanitizado da execução é enviado à API da Anthropic.
# ANTHROPIC_API_KEY=
# RESIDUO_AI_MODEL=claude-haiku-5-5   (padrão; o mais barato)
# RESIDUO_AI_BASE_URL=   (só para apontar para outro endpoint compatível; ANTHROPIC_BASE_URL é ignorada de propósito)
